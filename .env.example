# =============================================================================
# .env.example  --  environment variables
# =============================================================================
# Copy to ".env" for local use if you want to override a default:
#     cp .env.example .env
#
# IMPORTANT: this project needs NO secrets, API keys, or credentials to run or
# to deploy. The model is a local file (models/model.joblib), the API is
# public, and the frontend talks to it over a same-origin relative path
# (/api/predict). There is nothing here to keep secret.
#
# Never commit a real ".env" — it is already covered by .gitignore.
# The variables below are OPTIONAL, non-secret convenience knobs only.
# =============================================================================

# Port for the local dev server (local_server.py). Default: 8000.
# Not used by Vercel (Vercel assigns the port at runtime).
PORT=8000
