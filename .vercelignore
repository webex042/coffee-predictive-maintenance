# =============================================================================
# .vercelignore  --  keep the Vercel deployment lean
# =============================================================================
# Files/dirs listed here are NOT uploaded to Vercel. We ship only what serves
# the site + runs the model: public/, api/, service/, src/, config.py,
# models/, vercel.json, requirements.txt.
#
# NOTE: do NOT add src/, config.py, service/, models/ or public/ here — the
# serverless function bundles them (see "includeFiles" in vercel.json).
# =============================================================================

# Virtual environments
.venv/
venv/

# Python caches
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/

# Original Streamlit dashboard (replaced by the static frontend on Vercel)
.streamlit/
dashboard/

# Notebooks & exploration
notebooks/
.ipynb_checkpoints/

# Generated datasets (regenerated by the simulator; the model doesn't need them)
data/

# Tests & full dev dependency set
tests/
requirements-dev.txt

# Local-only dev server (Vercel runs api/predict.py directly)
local_server.py

# Docs / media assets
screenshots/

# Editor / agent / VCS
.claude/
.git/
.gitignore
.env
